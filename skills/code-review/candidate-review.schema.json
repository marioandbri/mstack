{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-skills.local/code-review/candidate-review.schema.json",
  "title": "Code review request",
  "description": "The request envelope for manual fixed-point reviews and immutable Review Unit Candidate reviews.",
  "oneOf": [
    {
      "$ref": "#/$defs/fixedPointRequest"
    },
    {
      "$ref": "#/$defs/candidateRequest"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitObjectId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$)).+$"
    },
    "fixedPointRequest": {
      "type": "object",
      "description": "The existing manual review request. Omitting mode is retained as a fixed-point compatibility path.",
      "required": [
        "fixedPoint"
      ],
      "properties": {
        "mode": {
          "const": "fixed-point"
        },
        "fixedPoint": {
          "type": "string",
          "minLength": 1
        },
        "thermo": {
          "type": "boolean"
        }
      },
      "not": {
        "required": [
          "candidate"
        ]
      },
      "additionalProperties": true
    },
    "candidateRequest": {
      "type": "object",
      "required": [
        "mode",
        "protocolVersion",
        "axis",
        "candidate",
        "candidateHash",
        "workspace",
        "context"
      ],
      "properties": {
        "mode": {
          "const": "candidate"
        },
        "protocolVersion": {
          "const": "candidate.v1"
        },
        "axis": {
          "enum": [
            "standards",
            "spec",
            "structural_quality"
          ]
        },
        "candidate": {
          "$ref": "#/$defs/reviewUnitCandidate"
        },
        "candidateHash": {
          "$ref": "#/$defs/sha256"
        },
        "workspace": {
          "$ref": "#/$defs/workspaceBinding"
        },
        "context": {
          "$ref": "#/$defs/axisContext"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "fixedPoint"
            ]
          },
          {
            "required": [
              "thermo"
            ]
          }
        ]
      },
      "additionalProperties": false
    },
    "reviewUnitCandidate": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "runId",
        "reviewUnitId",
        "repositoryFingerprint",
        "base",
        "aggregate",
        "memberCandidates",
        "authorityManifestHash",
        "reviewRequirementDecisionId",
        "reviewRequirementDecisionHash",
        "interactionValidation",
        "skillProvenance",
        "createdAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": 4
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "runId": {
          "$ref": "#/$defs/identifier"
        },
        "reviewUnitId": {
          "$ref": "#/$defs/identifier"
        },
        "repositoryFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "base": {
          "$ref": "#/$defs/baseBinding"
        },
        "aggregate": {
          "$ref": "#/$defs/aggregateBinding"
        },
        "memberCandidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/memberCandidate"
          }
        },
        "authorityManifestHash": {
          "$ref": "#/$defs/sha256"
        },
        "reviewRequirementDecisionId": {
          "$ref": "#/$defs/identifier"
        },
        "reviewRequirementDecisionHash": {
          "$ref": "#/$defs/sha256"
        },
        "interactionValidation": {
          "$ref": "#/$defs/interactionValidation"
        },
        "skillProvenance": {
          "$ref": "#/$defs/skillProvenance"
        },
        "workspacePath": {
          "type": "string",
          "pattern": "^/"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "baseBinding": {
      "type": "object",
      "required": [
        "headHash",
        "treeHash"
      ],
      "properties": {
        "headHash": {
          "$ref": "#/$defs/gitObjectId"
        },
        "treeHash": {
          "$ref": "#/$defs/gitObjectId"
        }
      },
      "additionalProperties": false
    },
    "aggregateBinding": {
      "type": "object",
      "required": [
        "treeHash",
        "diffHash",
        "patchHash",
        "patchPath",
        "changedPaths",
        "changedPathInventoryHash"
      ],
      "properties": {
        "treeHash": {
          "$ref": "#/$defs/gitObjectId"
        },
        "diffHash": {
          "$ref": "#/$defs/sha256"
        },
        "patchHash": {
          "$ref": "#/$defs/sha256"
        },
        "patchPath": {
          "type": "string",
          "pattern": "^/"
        },
        "changedPaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/changedPath"
          }
        },
        "changedPathInventoryHash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "changedPath": {
      "type": "object",
      "required": [
        "path",
        "status"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "status": {
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed",
            "copied",
            "type_changed"
          ]
        },
        "oldPath": {
          "$ref": "#/$defs/path"
        },
        "mode": {
          "type": "integer",
          "minimum": 0
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "renamed"
              }
            }
          },
          "then": {
            "required": [
              "oldPath"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "memberCandidate": {
      "type": "object",
      "required": [
        "candidateId",
        "candidateHash",
        "workOrderId",
        "assignmentId",
        "patchHash",
        "evidenceManifestId",
        "evidenceManifestHash",
        "validationSnapshotId",
        "validationSnapshotHash",
        "authorityManifestHash",
        "dependencyOrder"
      ],
      "properties": {
        "candidateId": {
          "$ref": "#/$defs/identifier"
        },
        "candidateHash": {
          "$ref": "#/$defs/sha256"
        },
        "workOrderId": {
          "$ref": "#/$defs/identifier"
        },
        "assignmentId": {
          "$ref": "#/$defs/identifier"
        },
        "patchHash": {
          "$ref": "#/$defs/sha256"
        },
        "evidenceManifestId": {
          "$ref": "#/$defs/identifier"
        },
        "evidenceManifestHash": {
          "$ref": "#/$defs/sha256"
        },
        "validationSnapshotId": {
          "$ref": "#/$defs/identifier"
        },
        "validationSnapshotHash": {
          "$ref": "#/$defs/sha256"
        },
        "authorityManifestHash": {
          "$ref": "#/$defs/sha256"
        },
        "dependencyOrder": {
          "type": "integer",
          "minimum": 0
        },
        "changedFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      },
      "additionalProperties": false
    },
    "interactionValidation": {
      "type": "object",
      "required": [
        "id",
        "snapshotHash",
        "passed",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "snapshotHash": {
          "$ref": "#/$defs/sha256"
        },
        "passed": {
          "const": true
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "skillProvenance": {
      "type": "object",
      "required": [
        "repository",
        "revision",
        "packageHashes",
        "referenceHashes"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^/"
        },
        "revision": {
          "$ref": "#/$defs/gitObjectId"
        },
        "packageHashes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          },
          "minProperties": 1
        },
        "referenceHashes": {
          "type": "object",
          "required": [
            "skills/code-review/SMELL-BASELINE.md",
            "skills/code-review/candidate-review.schema.json",
            "skills/thermo-nuclear-code-quality-review/thermo-nuclear-code-quality-reviewer.md"
          ],
          "properties": {
            "skills/code-review/SMELL-BASELINE.md": {
              "$ref": "#/$defs/sha256"
            },
            "skills/code-review/candidate-review.schema.json": {
              "$ref": "#/$defs/sha256"
            },
            "skills/thermo-nuclear-code-quality-review/thermo-nuclear-code-quality-reviewer.md": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "workspaceBinding": {
      "type": "object",
      "required": [
        "root",
        "repositoryFingerprint",
        "expectedHeadHash",
        "expectedTreeHash",
        "expectedChangedPathsHash",
        "clean"
      ],
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^/"
        },
        "repositoryFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "expectedHeadHash": {
          "$ref": "#/$defs/gitObjectId"
        },
        "expectedTreeHash": {
          "$ref": "#/$defs/gitObjectId"
        },
        "expectedChangedPathsHash": {
          "$ref": "#/$defs/sha256"
        },
        "clean": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "axisContext": {
      "type": "object",
      "required": [
        "contextHash",
        "documents",
        "protocolSources",
        "allowedPaths"
      ],
      "properties": {
        "contextHash": {
          "$ref": "#/$defs/sha256"
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hashedDocument"
          }
        },
        "protocolSources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/protocolSource"
          }
        },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      },
      "additionalProperties": false
    },
    "hashedDocument": {
      "type": "object",
      "required": [
        "path",
        "hash",
        "content"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "hash": {
          "$ref": "#/$defs/sha256"
        },
        "content": {}
      },
      "additionalProperties": false
    },
    "protocolSource": {
      "type": "object",
      "required": [
        "path",
        "hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
