{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reflect review proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "phase",
    "mode",
    "scope",
    "sources",
    "coverage",
    "opportunities",
    "promotion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "phase": {
      "enum": [
        "reviewing",
        "ready-for-proposal"
      ]
    },
    "mode": {
      "enum": [
        "inbox",
        "session",
        "instructions",
        "capture-only"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "promotion": {
      "const": "none"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "sha256"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section",
          "status"
        ],
        "properties": {
          "section": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "pending",
              "reviewed",
              "deferred"
            ]
          }
        }
      }
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "basis",
          "observation",
          "evidence",
          "suspectedCause",
          "recommendation",
          "question",
          "decision",
          "observationIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "basis": {
            "enum": [
              "observed-failure",
              "static-risk",
              "user-preference",
              "technical-fact",
              "new-capability"
            ]
          },
          "observation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "summary"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          },
          "suspectedCause": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "recommendation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "answer",
              "scope"
            ],
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "keep",
                  "adjust",
                  "add",
                  "remove",
                  "summarize",
                  "move",
                  "reject",
                  "defer"
                ]
              },
              "answer": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "pending"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "answer": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "answer": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                }
              }
            ]
          },
          "observationIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "instructions"
          }
        }
      },
      "then": {
        "properties": {
          "coverage": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "ready-for-proposal"
          }
        }
      },
      "then": {
        "properties": {
          "coverage": {
            "items": {
              "properties": {
                "status": {
                  "enum": [
                    "reviewed",
                    "deferred"
                  ]
                }
              }
            }
          },
          "opportunities": {
            "items": {
              "properties": {
                "decision": {
                  "properties": {
                    "status": {
                      "enum": [
                        "keep",
                        "adjust",
                        "add",
                        "remove",
                        "summarize",
                        "move",
                        "reject",
                        "defer"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
