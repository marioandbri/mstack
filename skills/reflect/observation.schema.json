{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reflect inbox observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "status",
    "scope",
    "basis",
    "observation",
    "evidence",
    "suspectedCause"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "const": "inbox"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "basis": {
      "enum": [
        "observed-failure",
        "static-risk",
        "user-preference",
        "technical-fact",
        "new-capability"
      ]
    },
    "observation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "summary"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "suspectedCause": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
