{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned factual reconstruction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input_sha256",
    "previous_revision",
    "mode",
    "prepared_at",
    "author",
    "linked_observation_ids",
    "request",
    "scope",
    "constraints",
    "actions",
    "results",
    "corrections",
    "authorizations",
    "hypotheses",
    "contradictions",
    "instructions",
    "expected",
    "unknowns",
    "completeness",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_revision": {
      "type": "integer",
      "minimum": 0
    },
    "mode": {
      "enum": [
        "origin",
        "posthoc"
      ]
    },
    "prepared_at": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "linked_observation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "request": {
      "anyOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "authorizations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "availability",
          "temporal_role",
          "evidence_ids"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "availability": {
            "enum": [
              "unknown",
              "catalog-exposed",
              "available",
              "selected",
              "read",
              "loaded"
            ]
          },
          "temporal_role": {
            "enum": [
              "historical",
              "consulted-after"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "expected": {
      "anyOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "type": "null"
        }
      ]
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "completeness": {
      "enum": [
        "partial",
        "complete"
      ]
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source_ids",
        "actor",
        "order"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "actor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "order": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "excerpts"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "sha256",
              "kind",
              "temporal_role",
              "availability"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              },
              "kind": {
                "enum": [
                  "observation",
                  "message",
                  "runtime-evidence",
                  "instruction",
                  "artifact"
                ]
              },
              "temporal_role": {
                "enum": [
                  "historical",
                  "consulted-after"
                ]
              },
              "availability": {
                "enum": [
                  "retained",
                  "reference-only",
                  "unavailable"
                ]
              }
            }
          }
        },
        "excerpts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source_id",
              "text",
              "sanitized",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "source_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "maxLength": 4000
              },
              "sanitized": {
                "const": true
              },
              "kind": {
                "enum": [
                  "quote",
                  "record-text",
                  "paraphrase"
                ]
              }
            }
          }
        }
      }
    }
  }
}
