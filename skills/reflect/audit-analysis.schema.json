{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned agent maintenance audit analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "scope", "inventory_sha256", "analyst", "coverage", "findings", "priority_order"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/text"},
    "scope": {"$ref": "#/$defs/text"},
    "inventory_sha256": {"$ref": "#/$defs/hash"},
    "analyst": {
      "type": "object", "additionalProperties": false, "required": ["provider", "version"],
      "properties": {"provider": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"}}
    },
    "coverage": {
      "type": "object", "additionalProperties": false, "required": ["reviewed", "limits"],
      "properties": {"reviewed": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "limits": {"$ref": "#/$defs/texts"}}
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "priority_order": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "texts": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["source_id", "sha256", "excerpt"],
      "properties": {
        "source_id": {"$ref": "#/$defs/text"},
        "sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "excerpt": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 1200}, {"type": "null"}]}
      }
    },
    "semantic_basis": {
      "type": "object", "additionalProperties": false, "required": ["responsibility", "scope_compatibility", "meaning"],
      "properties": {"responsibility": {"$ref": "#/$defs/text"}, "scope_compatibility": {"$ref": "#/$defs/text"}, "meaning": {"$ref": "#/$defs/text"}}
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "scope", "target", "claim", "evidence_type", "source_refs", "observation", "suspected_cause", "impact", "uncertainty", "recommendation", "semantic_basis", "priority_reason"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "scope": {"$ref": "#/$defs/text"}, "target": {"$ref": "#/$defs/text"},
        "claim": {"enum": ["opportunity", "duplication", "contradiction", "obsolescence", "complementarity"]},
        "evidence_type": {"enum": ["structural", "semantic", "behavioral"]},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
        "observation": {"$ref": "#/$defs/text"},
        "suspected_cause": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "impact": {"$ref": "#/$defs/text"}, "uncertainty": {"$ref": "#/$defs/texts"}, "priority_reason": {"$ref": "#/$defs/text"},
        "recommendation": {
          "type": "object", "additionalProperties": false, "required": ["operation", "reason"],
          "properties": {"operation": {"enum": ["KEEP", "REMOVE", "MOVE", "MERGE", "SPLIT", "ADD", "MECHANIZE"]}, "reason": {"$ref": "#/$defs/text"}}
        },
        "semantic_basis": {"anyOf": [{"$ref": "#/$defs/semantic_basis"}, {"type": "null"}]}
      }
    }
  }
}
